# Copy to .env.local for local development. Only VITE_* values are bundled into
# the browser build. NEVER put the service-role / secret key in a VITE_ variable.

# Supabase project URL (Project Settings -> API). Local: http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy anon key. Safe for browsers.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public origin used in registration links, pass links and QR codes,
# e.g. https://passes.example.org. Defaults to the origin serving the app.
VITE_PUBLIC_SITE_URL=
