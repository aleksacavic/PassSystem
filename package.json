{
  "name": "passsystem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-event QR registration and access control",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run test:e2e",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs dist",
    "db:start": "supabase start -x studio,imgproxy,storage-api,logflare,vector,postgres-meta,supavisor,realtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status -o env",
    "staff:create": "node scripts/create-staff-user.mjs",
    "db:seed:dev": "node scripts/dev-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "barcode-detector": "^3.2.3",
    "lucide-react": "1.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
